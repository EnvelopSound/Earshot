  "_comment_resolutions": "dashjs 3.1.2 depends on request and request-promise, which nothing in the shipped page loads: dash.js ships its own bundle. Their own dependencies would otherwise resolve to versions with open advisories (form-data 2.3, qs 6.5, tough-cookie 2.5, uuid 3), so the pins above are scoped to request and request-promise only; a global tough-cookie pin would break jsdom, which needs ^6.",
  "resolutions": {
    "**/request/form-data": "2.5.6",
    "**/request/qs": "6.16.2",
    "**/request/tough-cookie": "4.1.3",
    "**/request/uuid": "11.1.1",
    "**/request-promise/tough-cookie": "4.1.3"
  }
}
